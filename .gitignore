# ---- Secrets — NEVER commit ----
.env
core/config/api_keys.json
core/config/firebase_config.json
core/config/smart_home.key
core/config/certs/

# ---- Python ----
.venv/
__pycache__/
*.py[cod]

# ---- Personal assistant data (code ships, data stays ignored) ----
# memory/ — track *.py code, ignore the data files
core/memory/MEMORY.md
core/memory/USER.md
core/memory/benchmarks.json
core/memory/chat_history.jsonl
core/memory/clipboard_history.json
core/memory/long_term.json
# data/ — track database.py code, ignore generated content + db
core/data/*.txt
core/data/*.db
core/data/*.sqlite3
# staging/ — runtime forge scratch
dashboard/staging/

# ---- Databases ----
*.db
*.sqlite3

# ---- Logs ----
*.log
ira_startup.log

# ---- Local dev scratch (preview renders, QA scratch, archive) ----
_scratch/
_preview.py
_qa_*.py
_prev_*.png
_polish_*.png

# ---- Runtime lock files ----
core/memory/*.lock

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Claude Code project instructions (kept local, not for public repo) ----
CLAUDE.md

# ---- Node/Next.js build artifacts (orb-ui is a sub-app) ----
orb-ui/node_modules/
orb-ui/.next/
orb-ui/out/
orb-ui/.vercel/
node_modules/

# ---- Runtime-generated content (code ships, artifacts stay local) ----
Data/
*.jpg
*.jpeg
*.png
*.pptx
*.db
*.sqlite3
*.task
