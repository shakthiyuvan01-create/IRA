# Provider chain for chat and tool calls, tried left to right.
# Names: gemini, aimlapi, xkiro, openrouter, ollama, local_gguf
# ollama after the cloud providers = offline fallback. Put it first to answer locally
# by default (slower on a CPU-only PC: roughly 20-90 s per reply with qwen3:4b-instruct).
AI_PROVIDER_ORDER=gemini,aimlapi,xkiro,openrouter,ollama,local_gguf
GEMINI_API_KEY= (read from core/config/api_keys.json if not set here)
GEMINI_MODEL=gemini-2.5-flash

# AI/ML API OpenAI-compatible fallback
AIMLAPI_API_KEY=
AIMLAPI_BASE_URL=https://api.aimlapi.com/v1
AIMLAPI_MODEL=alibaba/qwen3.7-max

# Xkiro OpenAI-compatible fallback
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=cohere/command-a
XKIRO_API_KEY=

# OpenRouter chat fallback. OPENROUTER_MODEL must be a chat model.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
# This is an embeddings-only model; it cannot answer chat requests or run tools.
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free

# Composio app integrations. Add your Composio project key to the ignored .env file.
# Every app with an ACTIVE connection in the Composio project is exposed to IRA,
# discovered live, so a newly connected app works without a restart.
COMPOSIO_API_KEY=
# "all" exposes every connected app. A comma list (gmail,googledrive,...) narrows it.
COMPOSIO_TOOLKITS=all
# "all" uses connected accounts of every Composio user id. A comma list narrows it.
COMPOSIO_USER_IDS=all
# User id that new connections made from IRA are created under.
COMPOSIO_USER_ID=ira-local-user

# Local GGUF fallback (model file is in the project root)
HF_GGUF_MODEL=../Runtime/Meta-Llama-3.1-8B-Instruct-Q8_0.gguf
HF_GGUF_BASE_URL=http://127.0.0.1:8081
HF_GGUF_CTX_SIZE=4096
HF_GGUF_STARTUP_TIMEOUT=180
# Optional absolute path if llama-server is not on PATH:
# LLAMA_SERVER_PATH=C:\\path\\to\\llama-server.exe

# Local Ollama (https://ollama.com). No API key needed.
# Install a model once with: ollama pull qwen3:4b-instruct
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT=240
# Most tool schemas sent to the local model per request (0 sends all).
OLLAMA_MAX_TOOLS=8
OLLAMA_AUTOSTART=1

# NASA Astronomy Picture of the Day wallpaper. DEMO_KEY works with low rate limits;
# a free key from https://api.nasa.gov raises them.
NASA_API_KEY=

# Vision (live screen mode, "look at my screen", image questions). Tried in this order;
# a provider that is rate-limited is skipped for 10 minutes.
VISION_PROVIDER_ORDER=gemini,groq,openrouter,custom,ollama
# Groq: free key at https://console.groq.com/keys (fast vision model)
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OpenRouter free vision model (uses OPENROUTER_API_KEY above)
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free
# Any other OpenAI-compatible vision API
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
# Offline fallback (slow on a CPU): ollama pull llava
OLLAMA_VISION_MODEL=llava

# Fast local voice: pip install kokoro-onnx, then download kokoro-v1.0.onnx and
# voices-v1.0.bin from https://github.com/thewh1teagle/kokoro-onnx/releases (model-files-v1.0).
# Leave empty to use the slower PyTorch Kokoro voice.
KOKORO_ONNX_MODEL=
KOKORO_ONNX_VOICES=

# Your town, used for weather (overrides automatic location)
HOME_CITY=
