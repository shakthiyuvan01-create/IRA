# IRA — Multi-Provider & Self-Improvement Configuration
# Copy this to .env and fill in your keys

# === MULTI-PROVIDER CHAIN ===
# Order in which providers are tried (first 3 raced in parallel)
# Default: omniroute,github,gemini,nara,bluesminds,openai,ollama
# AI_PROVIDER_ORDER=omniroute,gemini,ollama

# === OMNIROUTE (237+ models behind one API) ===
# OMNIROUTE_API_KEY=
# OMNIROUTE_URL=http://localhost:20128/v1
# OMNIROUTE_MODEL=auto

# === GITHUB MODELS (free GPT-4o) ===
# GITHUB_TOKEN=

# === GEMINI (also used by the voice loop) ===
# GEMINI_API_KEY= (read from config/api_keys.json if not set here)
# GEMINI_MODEL=gemini-2.5-flash

# === NARA ROUTER ===
# NARA_API_KEY=
# NARA_MODEL=mistral-large
# NARA_BASE_URL=https://router.bynara.id/v1

# === BLUESMINDS ===
# BLUESMINDS_KEY=
# BLUESMINDS_MODEL=gpt-4o
# BLUESMINDS_BASE_URL=https://api.bluesminds.ai/v1

# === OPENAI ===
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# === OLLAMA (local) ===
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434

# === SELF-IMPROVEMENT ===
# HEARTBEAT_ENABLED=false
# HEARTBEAT_INTERVAL_MINUTES=30
